<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!-- Spring beans and JPA entities receive constructor-injected mutable references
         (e.g. ApiKeyFilter, Map<> paramsJson). Defensive copying would break Spring's
         DI contract and JPA lazy-loading. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- CSRF protection is intentionally disabled: this is a stateless REST/MCP API
         authenticated exclusively via X-API-Key headers. CSRF attacks require a browser
         session cookie, which this service never issues. -->
    <Match>
        <Bug pattern="SPRING_CSRF_PROTECTION_DISABLED"/>
    </Match>

    <!-- PostgresConnector validates table and column names against a hardcoded allowlist
         (ALLOWED_TABLES, ALL_COLUMNS) before any string concatenation, and all filter
         values use parameterized queries. FindSecBugs cannot trace through the allowlist
         check and raises a false positive. -->
    <Match>
        <Class name="io.ancoris.mcp.connector.PostgresConnector"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>

    <!-- DocumentSearchTool builds the IN-clause from a compile-time literal list of
         classification strings, not from user input. -->
    <Match>
        <Class name="io.ancoris.mcp.tools.DocumentSearchTool"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>

    <!-- RlsContextAspect sets a PostgreSQL session variable via SET LOCAL. PostgreSQL does
         not support parameterized SET LOCAL statements, so string interpolation is
         unavoidable. The interpolated value comes exclusively from AccessRole.name(),
         which is a Java enum — never from user input. -->
    <Match>
        <Class name="io.ancoris.mcp.security.RlsContextAspect"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>

    <!-- Test classes use JdbcTemplate with hardcoded SQL strings in mock stubs or
         test-fixture setup. No user input is involved; these are false positives. -->
    <Match>
        <Class name="io.ancoris.mcp.connector.DbContentStoreTest"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>
    <Match>
        <Class name="io.ancoris.mcp.connector.PostgresConnectorTest"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>
    <Match>
        <Class name="io.ancoris.mcp.security.RlsContextAspectTest"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>

    <!-- VectorSearchConnector builds the IN-clause from a compile-time literal list of
         classification strings (same pattern as DocumentSearchTool). The vector literal
         is a formatted float array — never user input. -->
    <Match>
        <Class name="io.ancoris.mcp.connector.VectorSearchConnector"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>

    <!-- SemanticSearchTool builds the classification IN-clause from AccessRole constants,
         not from user input. Same pattern as DocumentSearchTool. -->
    <Match>
        <Class name="io.ancoris.mcp.tools.SemanticSearchTool"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>

    <!-- EmbeddingInitializer runs parameterized SQL (UPDATE ... SET embedding = ?::vector)
         with a formatted float array — never user input. -->
    <Match>
        <Class name="io.ancoris.mcp.connector.EmbeddingInitializer"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>

    <!-- Test classes use JdbcTemplate with hardcoded SQL strings in mock stubs or
         test-fixture setup. No user input is involved; these are false positives. -->
    <Match>
        <Class name="io.ancoris.mcp.connector.VectorSearchConnectorTest"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>
    <Match>
        <Class name="io.ancoris.mcp.tools.SemanticSearchToolIT"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>

    <!-- Suppress false positives from Spring-generated proxy classes -->
    <Match>
        <Class name="~.*\$\$.*"/>
    </Match>

</FindBugsFilter>
