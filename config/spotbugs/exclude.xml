<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!-- Spring beans and JPA entities receive constructor-injected mutable references
         (e.g. ApiKeyFilter, Map<> paramsJson). Defensive copying would break Spring's
         DI contract and JPA lazy-loading. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- CSRF protection is intentionally disabled: this is a stateless REST/MCP API
         authenticated exclusively via X-API-Key headers. CSRF attacks require a browser
         session cookie, which this service never issues. -->
    <Match>
        <Bug pattern="SPRING_CSRF_PROTECTION_DISABLED"/>
    </Match>

    <!-- PostgresConnector validates table and column names against a hardcoded allowlist
         (ALLOWED_TABLES, ALL_COLUMNS) before any string concatenation, and all filter
         values use parameterized queries. FindSecBugs cannot trace through the allowlist
         check and raises a false positive. -->
    <Match>
        <Class name="io.ancoris.mcp.connector.PostgresConnector"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>

    <!-- DocumentSearchTool builds the IN-clause from a compile-time literal list of
         classification strings, not from user input. -->
    <Match>
        <Class name="io.ancoris.mcp.tools.DocumentSearchTool"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>

    <!-- RlsContextAspect uses PreparedStatementCallback with parameterised set_config()
         calls (V14 upgrade). FindSecBugs may still flag the execute(String, PSC) overload.
         The SQL string is a compile-time constant; parameters are bound via ps.setString(). -->
    <Match>
        <Class name="io.ancoris.mcp.security.RlsContextAspect"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>

    <!-- Test classes use JdbcTemplate with hardcoded SQL strings in mock stubs or
         test-fixture setup. No user input is involved; these are false positives. -->
    <Match>
        <Class name="io.ancoris.mcp.connector.DbContentStoreTest"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>
    <Match>
        <Class name="io.ancoris.mcp.connector.PostgresConnectorTest"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>
    <Match>
        <Class name="io.ancoris.mcp.security.RlsContextAspectTest"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>

    <!-- VectorSearchConnector builds the IN-clause from a compile-time literal list of
         classification strings (same pattern as DocumentSearchTool). The vector literal
         is a formatted float array — never user input. -->
    <Match>
        <Class name="io.ancoris.mcp.connector.VectorSearchConnector"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>

    <!-- SemanticSearchTool builds the classification IN-clause from AccessRole constants,
         not from user input. Same pattern as DocumentSearchTool. -->
    <Match>
        <Class name="io.ancoris.mcp.tools.SemanticSearchTool"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>

    <!-- EmbeddingInitializer runs parameterized SQL (UPDATE ... SET embedding = ?::vector)
         with a formatted float array — never user input. -->
    <Match>
        <Class name="io.ancoris.mcp.connector.EmbeddingInitializer"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>

    <!-- Test classes use JdbcTemplate with hardcoded SQL strings in mock stubs or
         test-fixture setup. No user input is involved; these are false positives. -->
    <Match>
        <Class name="io.ancoris.mcp.connector.VectorSearchConnectorTest"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>
    <Match>
        <Class name="io.ancoris.mcp.tools.SemanticSearchToolIT"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>
    <!-- RlsWorkspaceIsolationIT uses hardcoded SQL strings (SET LOCAL ROLE, set_config PSC).
         All SQL is compile-time; no user input reaches any JdbcTemplate call. -->
    <Match>
        <Class name="io.ancoris.mcp.security.RlsWorkspaceIsolationIT"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>

    <!-- D5 scheduled-job unit tests exercise Mockito.when(jdbc.update(contains(...))) on
         compile-time SQL literals. No user input reaches any JdbcTemplate call. -->
    <Match>
        <Class name="io.ancoris.mcp.security.RateLimitStatePrunerTest"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>
    <Match>
        <Class name="io.ancoris.mcp.security.ApiKeyExpirySweeperTest"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>
    <!-- ChunkBudgetEnforcerIT inserts/selects test fixtures via JdbcTemplate; SQL is
         compile-time, UUIDs and longs are bound. Same pattern as other *IT classes. -->
    <Match>
        <Class name="io.ancoris.mcp.security.ChunkBudgetEnforcerIT"/>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
    </Match>

    <!-- OAuthController.authorizeSubmit redirects to redirect_uri provided by the OAuth client.
         This is an intentional pattern in the OAuth 2.0 authorization code flow (RFC 6749 §4.1).
         FindSecBugs cannot distinguish the OAuth redirect from an arbitrary open redirect.
         Mitigation: redirect_uri must originate from the same client that initiated the flow;
         the auth code binds the code to the original redirect_uri and is verified at token time. -->
    <Match>
        <Class name="io.ancoris.mcp.oauth.OAuthController"/>
        <Bug pattern="UNVALIDATED_REDIRECT"/>
    </Match>

    <!-- OAuthController.buildAuthorizeForm generates HTML by String interpolation.
         All user-supplied values (clientId, redirectUri, state, etc.) are passed through
         escapeHtml() before insertion. FindSecBugs cannot trace through the custom helper. -->
    <Match>
        <Class name="io.ancoris.mcp.oauth.OAuthController"/>
        <Bug pattern="XSS_SERVLET,XSS_REQUEST_PARAMETER_TO_SERVLET_WRITER"/>
    </Match>

    <!-- ApiKeyFilter.sendUnauthorized() writes a JSON error body. The `message` argument
         is always a compile-time string literal ("Invalid API key", "Invalid Bearer token",
         "Authentication required") — never user input. Content-Type is application/json.
         SpotBugs 6.5.0 cannot trace through the private-method boundary. -->
    <Match>
        <Class name="io.ancoris.mcp.security.ApiKeyFilter"/>
        <Bug pattern="XSS_SERVLET"/>
    </Match>

    <!-- VA_FORMAT_STRING_USES_NEWLINE: \n inside Java text blocks used as SQL / HTML
         templates, not as printf-style format strings targeting a terminal.
         %n would produce a platform-specific line separator, which is wrong for SQL
         and HTML payloads. SpotBugs 6.5.0 triggers on any .formatted() call whose
         template contains \n, regardless of context. -->
    <Match>
        <Class name="io.ancoris.mcp.connector.VectorSearchConnector"/>
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
    </Match>
    <Match>
        <Class name="io.ancoris.mcp.tools.DocumentSearchTool"/>
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
    </Match>
    <Match>
        <Class name="io.ancoris.mcp.oauth.OAuthController"/>
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
    </Match>

    <!-- Suppress false positives from Spring-generated proxy classes -->
    <Match>
        <Class name="~.*\$\$.*"/>
    </Match>

    <!-- McpRemoteEndToEndIT uses a trust-all X509TrustManager to accept the LE staging
         certificate on the OVH test cluster. This is intentional, test-only code, not
         production trust configuration. -->
    <Match>
        <Class name="io.ancoris.mcp.McpRemoteEndToEndIT$1"/>
        <Bug pattern="WEAK_TRUST_MANAGER"/>
    </Match>

</FindBugsFilter>
