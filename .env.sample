# MCP Data Gateway — environment variable template
#
# Copy this file to .env.local (gitignored) for local development.
# Production values are injected via K8s Secrets → env at runtime.
# NEVER commit real values to source control.

# ── Java gateway (Spring Boot) ────────────────────────────────────────────────
MCP_HMAC_PEPPER=
MCP_CONTENT_KEY=
MCP_JWT_SECRET=
DB_URL=
DB_USER=
DB_PASSWORD=
TEI_BASE_URL=http://tei:8080

# ── Rust ingestion daemon (microsoft_graph connector) ────────────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_DRIVE_ID=

# ── Rust ingestion daemon (zoho_workdrive connector) ─────────────────────────
# Leave blank — real values are provisioned into the K8s Secret before cluster
# deploy.  The ingestion daemon skips the Zoho connector when these are unset.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ROOT_ID=
ZOHO_DC=eu

# ── Local E2E gate (live Zoho smoke test) ─────────────────────────────────────
# Set to 1 and supply real ZOHO_* creds to run the live Zoho smoke test locally.
# Never set in CI. Never commit a non-empty ZOHO_REFRESH_TOKEN value.
ZOHO_INGESTION_E2E=
