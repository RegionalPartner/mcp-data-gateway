# Goose config example — mcp-data-gateway + OVH MCP server
#
# Copy the relevant blocks into: ~/.config/goose/config.yaml
#
# Goose version tested: v1.29.1
# Docs: https://block.github.io/goose/docs/guides/config-files/

extensions:
  # ── mcp-data-gateway (local dev) ──────────────────────────────────────────
  # Points Goose at the local docker-compose stack.
  # The gateway exposes three tools: list_sources, query_database, search_documents.
  mcp_data_gateway_local:
    type: streamable_http
    uri: http://localhost:8080/mcp
    headers:
      X-API-Key: demo-readonly-key-001     # READ_ONLY role — local dev only, rotate before production
      # X-API-Key: demo-admin-key-001      # ADMIN role (all columns + CONFIDENTIAL docs)
    timeout: 30
    enabled: true

  # ── mcp-data-gateway (production) ─────────────────────────────────────────
  # Use an environment variable so the key is never hardcoded.
  # Set: export MCP_GW_API_KEY=<your-key> before running goose.
  #
  # mcp_data_gateway_prod:
  #   type: streamable_http
  #   uri: https://mcp.your-domain.com/mcp
  #   headers:
  #     X-API-Key: "${MCP_GW_API_KEY}"
  #   timeout: 30
  #   enabled: true

  # ── OVH infrastructure MCP server (EU region) ─────────────────────────────
  # Exposes OVHcloud infrastructure management tools (compute, storage, DNS, billing).
  # Requires OAuth2 browser login — run `goose` once to authenticate.
  # Complement to mcp-data-gateway: data ops here, infra ops there.
  #
  # ovh_infra:
  #   type: streamable_http
  #   uri: https://mcp.eu.ovhcloud.com/mcp
  #   timeout: 60
  #   enabled: true
